{
  "description": "Neb: SessionStart (arranque) y hooks opcionales, que se activan con NEB_HOOKS / NEB_PROJECT_HOOKS (ver hooks/README.md).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 1 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 1"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 2 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 2"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 3 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 3"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 4 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 4"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 5 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 5"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 6 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 6"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 7 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 7"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 8 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 8"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 9 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 9"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 10 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 10"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 11 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 11"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 12 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 12"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 1 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 1"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 2 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 2"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 3 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 3"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 4 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 4"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 5 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 5"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 6 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 6"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 7 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 7"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 8 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 8"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 9 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 9"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 10 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 10"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 11 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 11"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 12 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 12"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 1 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 1"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 2 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 2"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 3 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 3"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 4 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 4"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 5 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 5"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 6 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 6"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 7 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 7"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 8 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 8"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 9 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 9"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 10 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 10"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 11 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 11"
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 12 || python3 \"${CLAUDE_PLUGIN_ROOT}/bootstrap/neb-bootstrap-context.py\" --part 12"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "case \",$NEB_HOOKS,$NEB_PROJECT_HOOKS,\" in *,save-approved-plan,*) python \"${CLAUDE_PLUGIN_ROOT}/hooks/neb-hook.py\" save-approved-plan || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/neb-hook.py\" save-approved-plan ;; esac"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "case \",$NEB_HOOKS,$NEB_PROJECT_HOOKS,\" in *,logbook-sync,*) python \"${CLAUDE_PLUGIN_ROOT}/hooks/neb-hook.py\" logbook-sync || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/neb-hook.py\" logbook-sync ;; esac"
          },
          {
            "type": "command",
            "command": "case \",$NEB_HOOKS,$NEB_PROJECT_HOOKS,\" in *,notify-on-stop,*) python \"${CLAUDE_PLUGIN_ROOT}/hooks/neb-hook.py\" notify-on-stop || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/neb-hook.py\" notify-on-stop ;; esac",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "case \",$NEB_HOOKS,$NEB_PROJECT_HOOKS,\" in *,logbook-sync,*) python \"${CLAUDE_PLUGIN_ROOT}/hooks/neb-hook.py\" logbook-sync || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/neb-hook.py\" logbook-sync ;; esac"
          },
          {
            "type": "command",
            "command": "case \",$NEB_HOOKS,$NEB_PROJECT_HOOKS,\" in *,ops-capture,*) python \"${CLAUDE_PLUGIN_ROOT}/hooks/neb-hook.py\" ops-capture || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/neb-hook.py\" ops-capture ;; esac"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "case \",$NEB_HOOKS,$NEB_PROJECT_HOOKS,\" in *,logbook-sync,*) python \"${CLAUDE_PLUGIN_ROOT}/hooks/neb-hook.py\" logbook-sync || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/neb-hook.py\" logbook-sync ;; esac"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "case \",$NEB_HOOKS,$NEB_PROJECT_HOOKS,\" in *,preprocess-prompt,*) python \"${CLAUDE_PLUGIN_ROOT}/hooks/neb-hook.py\" preprocess-prompt || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/neb-hook.py\" preprocess-prompt ;; esac",
            "timeout": 35
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "case \",$NEB_HOOKS,$NEB_PROJECT_HOOKS,\" in *,notify-on-permission,*) python \"${CLAUDE_PLUGIN_ROOT}/hooks/neb-hook.py\" notify-on-permission || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/neb-hook.py\" notify-on-permission ;; esac",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
